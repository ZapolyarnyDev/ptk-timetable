#!/bin/sh
set -e

case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) ./gradlew.bat spotlessApply ;;
  *) ./gradlew spotlessApply ;;
esac

git diff --cached --name-only | while IFS= read -r file; do
  [ -z "$file" ] || git add -- "$file"
done

case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) ./gradlew.bat spotlessCheck ;;
  *) ./gradlew spotlessCheck ;;
esac
